{
    "Settings": {
        "Database": {
            "ConnectionString": "${Settings__Database__ConnectionString}",
            "DatabaseName": "${Settings__Database__DatabaseName}"
        },
        "Authentication": {
            "Authority": "${Settings__Authentication__Authority}",
            "Audience": "${Settings__Authentication__Audience}"
        },
        "AbacatePay": {
            "Url": "${Settings__AbacatePay__Url}"
        },
        "Observability": {
            "SeqServerUrl": "${Settings__Observability__SeqServerUrl}",
            "SentryDsn": "${Settings__Observability__SentryDsn}"
        }
    },
    "Serilog": {
        "MinimumLevel": "Information",
        "Using": [
            "Serilog.Sinks.Console",
            "Serilog.Sinks.Seq"
        ],
        "Enrich": [
            "FromLogContext"
        ]
    }
}
